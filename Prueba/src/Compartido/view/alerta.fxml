<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<VBox fx:id="capaAlerta" xmlns:fx="http://javafx.com/fxml"
      fx:controller="Compartido.controller.alertaController"
      styleClass="capaAlerta"
      stylesheets="@/Compartido/style/estilos.css"
      visible="false" >

        <!-- CONTENEDOR DEL MODAL -->
        <VBox fx:id="alertaModal" styleClass="alertaModal" >
            <HBox styleClass="alertaEncabezado">
                <Label fx:id="alertaTitulo" styleClass="alertaTitulo" text="Título" />
            </HBox>
            <VBox styleClass="alertaContenido">
                <Label fx:id="alertaMensaje" styleClass="alertaMensaje" wrapText="true"/>
                <Button text="Aceptar" styleClass="alertaBoton" onAction="#cerrarAlerta" />
            </VBox>
        </VBox>

</VBox>
