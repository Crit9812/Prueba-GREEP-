<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Reportes.historial.controller.DetalleFacturaController"
            prefHeight="520"
            prefWidth="760"
            style="-fx-background-color: white;">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color: white;">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>
            <Label fx:id="lblTitulo"
                   text="Detalles"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <CheckBox fx:id="chkDetallado" text="Detallado"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: white; -fx-border-color: transparent;">
            <content>
                <VBox fx:id="contenedorDetalles"
                      spacing="12"
                      alignment="TOP_LEFT"
                      style="-fx-padding: 20; -fx-background-color: white;"/>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="12" style="-fx-background-color: white;">
            <padding>
                <Insets top="10" bottom="20"/>
            </padding>
            <Button fx:id="btnCancelarEntrada" text="Cancelar entrada" onAction="#cancelarEntrada"/>
            <Button fx:id="btnCancelar" text="Cancelar" onAction="#cancelarSalida"/>
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrarVentana"/>
        </HBox>
    </bottom>
</BorderPane>
