<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           xmlns="http://javafx.com/javafx"
           fx:id="root">

    <BorderPane fx:id="mainLayout">
        <top>
            <fx:include fx:id="paneNavbar" source="/Compartido/view/encabezado.fxml" />
        </top>

        <center>
            <SplitPane dividerPositions="0.03">
                <fx:include fx:id="navbar" source="/Compartido/view/navbar.fxml"/>
                <VBox fx:id="contenedor" styleClass="contenedor" alignment="CENTER" fillWidth="false">

                    <GridPane fx:id="buttonGrid" styleClass="contenedor-opciones">
                        <columnConstraints>
                            <ColumnConstraints halignment="CENTER" />
                            <ColumnConstraints halignment="CENTER" />
                            <ColumnConstraints halignment="CENTER" />
                            <ColumnConstraints halignment="CENTER" />
                        </columnConstraints>

                        <!-- Fila 1 -->
                        <Button styleClass="grid-button" GridPane.rowIndex="0" GridPane.columnIndex="0" text="Inventario" onAction="#ventanaInventario">
                            <graphic>
                                <ImageView fx:id="userIcon0" fitWidth="100" fitHeight="100">
                                    <image>
                                        <Image url="@/img/inventario.png" />
                                    </image>
                                </ImageView>

                            </graphic>
                        </Button>

                        <Button styleClass="grid-button" GridPane.rowIndex="0" GridPane.columnIndex="1" text="Historial por artículo" onAction="#ventanaHistorialArticulo">
                            <graphic>
                                <ImageView fx:id="userIcon1" fitWidth="100" fitHeight="100">
                                    <image>
                                        <Image url="@/img/historial_a.png" />
                                    </image>
                                </ImageView>

                            </graphic>
                        </Button>

                        <Button styleClass="grid-button" GridPane.rowIndex="0" GridPane.columnIndex="2" text="Historial por factura" onAction="#ventanaHistorial">
                            <graphic>
                                <ImageView fx:id="userIcon2" fitWidth="100" fitHeight="100">
                                    <image>
                                        <Image url="@/img/historial_f.png" />
                                    </image>
                                </ImageView>

                            </graphic>
                        </Button>

                        <Button fx:id="btnUtilidades" styleClass="grid-button" GridPane.rowIndex="0" GridPane.columnIndex="3" text="Utilidades" onAction="#ventanaUtilidades">
                            <graphic>
                                <ImageView fx:id="userIcon3" fitWidth="100" fitHeight="100">
                                    <image>
                                        <Image url="@/img/utilidades_f.png" />
                                    </image>
                                </ImageView>
                            </graphic>
                        </Button>
                    </GridPane>
                </VBox>
            </SplitPane>
        </center>
    </BorderPane>

</StackPane>
