<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Reportes.inventario.controller.DetalleInventarioController"
            prefHeight="520"
            prefWidth="760"
            styleClass="detalle-root">
    <stylesheets>
        <String fx:value="@/Reportes/inventario/style/detalle.css"/>
    </stylesheets>
    <top>
        <VBox spacing="10" styleClass="detalle-header">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>
            <Label fx:id="lblNombre"
                   text="Producto"
                   styleClass="detalle-title"/>
            <GridPane hgap="12" vgap="6" styleClass="detalle-grid">
                <Label text="Marca:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="detalle-subtitle"/>
                <Label fx:id="lblMarca" GridPane.rowIndex="0" GridPane.columnIndex="1" styleClass="detalle-value"/>

                <Label text="Material:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="detalle-subtitle"/>
                <Label fx:id="lblMaterial" GridPane.rowIndex="1" GridPane.columnIndex="1" styleClass="detalle-value"/>

                <Label text="Unidad de medida:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="detalle-subtitle"/>
                <Label fx:id="lblUnidad" GridPane.rowIndex="2" GridPane.columnIndex="1" styleClass="detalle-value"/>

                <Label text="Clasificación:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="detalle-subtitle"/>
                <Label fx:id="lblClasificacion" GridPane.rowIndex="3" GridPane.columnIndex="1" styleClass="detalle-value"/>

                <Label text="Descripción:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="detalle-subtitle"/>
                <Label fx:id="lblDescripcion" GridPane.rowIndex="4" GridPane.columnIndex="1" wrapText="true" styleClass="detalle-value"/>
            </GridPane>
        </VBox>
    </top>
    <center>
        <ScrollPane fx:id="scrollPane"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    styleClass="detalle-scroll">
            <content>
                <VBox fx:id="contenedorDetalles"
                      spacing="12"
                      alignment="TOP_LEFT"
                      style="-fx-padding: 20;"
                      styleClass="detalle-content"/>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="12" styleClass="detalle-footer">
            <padding>
                <Insets top="10" bottom="20"/>
            </padding>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCerrar" text="Cerrar" onAction="#cerrarVentana" styleClass="detalle-button"/>
        </HBox>
    </bottom>
</BorderPane>
