<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           xmlns="http://javafx.com/javafx"
           fx:controller="Configuracion.controller.MainController"
           fx:id="root"
           stylesheets="@/Configuracion/style/estilos.css">

    <VBox fx:id="contenedor" spacing="20" alignment="TOP_CENTER" styleClass="contenedor-config">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30" />
        </padding>

        <Label text="Configuración del Sistema"
               styleClass="titulo-config"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <VBox spacing="15" styleClass="panel-config" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <Label text="Configuración general" styleClass="subtitulo-config" />

            <GridPane hgap="12" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="140" prefWidth="160" />
                    <ColumnConstraints hgrow="ALWAYS" />
                </columnConstraints>

                <Label text="Sucursal:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalNombre" text="--" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Domicilio:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalDomicilio" text="--" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="CP:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalCp" text="--" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Colonia:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalColonia" text="--" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <Label text="Número int.:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalNumeroInt" text="--" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                <Label text="Número ext.:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalNumeroExt" text="--" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                <Label text="Ciudad:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalCiudad" text="--" GridPane.rowIndex="6" GridPane.columnIndex="1" />

                <Label text="Estado:" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalEstado" text="--" GridPane.rowIndex="7" GridPane.columnIndex="1" />

                <Label text="Localidad:" GridPane.rowIndex="8" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalLocalidad" text="--" GridPane.rowIndex="8" GridPane.columnIndex="1" />

                <Label text="País:" GridPane.rowIndex="9" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalPais" text="--" GridPane.rowIndex="9" GridPane.columnIndex="1" />

                <Label text="Correo:" GridPane.rowIndex="10" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalCorreo" text="--" GridPane.rowIndex="10" GridPane.columnIndex="1" />

                <Label text="Teléfono:" GridPane.rowIndex="11" GridPane.columnIndex="0" />
                <Label fx:id="lblSucursalTelefono" text="--" GridPane.rowIndex="11" GridPane.columnIndex="1" />
            </GridPane>

            <Separator />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="IVA global (%):" minWidth="120" />
                <TextField fx:id="txtIva" promptText="16" prefWidth="180" />
                <Button fx:id="btnGuardarIva" text="Guardar IVA" onAction="#guardarIva" />
                <Button fx:id="btnRecargarIva" text="Recargar" onAction="#recargarIva" />
            </HBox>

            <Label fx:id="lblIvaActual" text="IVA actual: --" />

            <Region VBox.vgrow="ALWAYS" />
        </VBox>

    </VBox>
</StackPane>
