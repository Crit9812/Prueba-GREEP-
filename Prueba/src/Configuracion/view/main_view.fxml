<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           xmlns="http://javafx.com/javafx"
           fx:controller="Configuracion.controller.MainController"
           fx:id="root"
           stylesheets="@/Configuracion/style/estilos.css">

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="config-scroll">
        <content>
            <VBox fx:id="contenedor" spacing="20" alignment="TOP_LEFT" styleClass="contenedor-config">
                <padding>
                    <Insets top="30" right="30" bottom="30" left="30" />
                </padding>

                <Label text="Configuración del Sistema" styleClass="titulo-config" />

                <VBox spacing="15" styleClass="panel-config">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>

                    <Label text="Configuración general" styleClass="subtitulo-config" />

                    <GridPane hgap="12" vgap="8">
                        <columnConstraints>
                            <ColumnConstraints minWidth="160" prefWidth="180" />
                            <ColumnConstraints hgrow="ALWAYS" />
                        </columnConstraints>

                        <Label text="Sucursal:" styleClass="etiqueta-campo" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalNombre" text="--" styleClass="valor-campo" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                        <Label text="Domicilio:" styleClass="etiqueta-campo" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalDomicilio" text="--" styleClass="valor-campo" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                        <Label text="CP:" styleClass="etiqueta-campo" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalCp" text="--" styleClass="valor-campo" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                        <Label text="Colonia:" styleClass="etiqueta-campo" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalColonia" text="--" styleClass="valor-campo" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                        <Label text="Número int.:" styleClass="etiqueta-campo" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalNumeroInt" text="--" styleClass="valor-campo" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                        <Label text="Número ext.:" styleClass="etiqueta-campo" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalNumeroExt" text="--" styleClass="valor-campo" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                        <Label text="Ciudad:" styleClass="etiqueta-campo" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalCiudad" text="--" styleClass="valor-campo" GridPane.rowIndex="6" GridPane.columnIndex="1" />

                        <Label text="Estado:" styleClass="etiqueta-campo" GridPane.rowIndex="7" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalEstado" text="--" styleClass="valor-campo" GridPane.rowIndex="7" GridPane.columnIndex="1" />

                        <Label text="Localidad:" styleClass="etiqueta-campo" GridPane.rowIndex="8" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalLocalidad" text="--" styleClass="valor-campo" GridPane.rowIndex="8" GridPane.columnIndex="1" />

                        <Label text="País:" styleClass="etiqueta-campo" GridPane.rowIndex="9" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalPais" text="--" styleClass="valor-campo" GridPane.rowIndex="9" GridPane.columnIndex="1" />

                        <Label text="Correo:" styleClass="etiqueta-campo" GridPane.rowIndex="10" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalCorreo" text="--" styleClass="valor-campo" GridPane.rowIndex="10" GridPane.columnIndex="1" />

                        <Label text="Teléfono:" styleClass="etiqueta-campo" GridPane.rowIndex="11" GridPane.columnIndex="0" />
                        <Label fx:id="lblSucursalTelefono" text="--" styleClass="valor-campo" GridPane.rowIndex="11" GridPane.columnIndex="1" />
                    </GridPane>

                    <Separator />

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="IVA global (%):" styleClass="etiqueta-campo" minWidth="160" />
                        <TextField fx:id="txtIva" promptText="16" prefWidth="180" />
                        <Button fx:id="btnGuardarIva" text="Guardar IVA" onAction="#guardarIva" styleClass="btn-config" />
                        <Button fx:id="btnRecargarIva" text="Recargar" onAction="#recargarIva" styleClass="btn-config" />
                    </HBox>

                    <Label fx:id="lblIvaActual" text="IVA actual: --" styleClass="valor-campo" />
                </VBox>

                <VBox spacing="12" styleClass="panel-config">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20" />
                    </padding>

                    <Label text="CONTROLES / ATAJOS DE TECLADO" styleClass="subtitulo-config" />

                    <Label text="GENERAL:" styleClass="seccion-atajo" />
                    <Label text="F1: Cerrar Sesión\nF2: Actualizar\nCtrl + B: Seleccionar barra de búsqueda\nCtrl + Space: Guardar un borrador de la interfaz actual\nAlt + F4: Cerrar el programa" styleClass="texto-atajo" wrapText="true" />

                    <Label text="NAVEGACIÓN ENTRE VENTANAS:" styleClass="seccion-atajo" />
                    <Label text="Shift + O: Menú de operaciones\nShift + R: Menú de reportes\nShift + CO: Menú de consultas\nShift + A: Apartado de ajustes / configuración\nShift + E: Ventana de Traspaso de Entrada\nShift + S: Ventana de Traspaso de Salida\nShift + CM: Ventana de Compra\nShift + V: Ventana de Venta\nShift + PE: Ventana de Pedidos\nShift + AI: Ventana de Ajuste de Inventario\nShift + RU: Ventana de Registrar Usuario\nShift + I: Ventana de Inventario\nShift + H: Ventana de Historial por Artículo\nShift + F: Ventana de Historial por Factura\nShift + U: Ventana de Utilidades\nShift + P: Ventana de Productos\nShift + PR: Ventana de Proveedores\nShift + SU: Ventana de Sucursales\nShift + C: Ventana de Clientes\nShift + CL: Ventana de Claves\nShift + CS: Ventana de Clasificación" styleClass="texto-atajo" wrapText="true" />

                    <Label text="ACCIONES EN VENTANAS:" styleClass="seccion-atajo" />
                    <Label text="Ctrl + A: Seleccionar todo\nCtrl + E: Eliminar seleccionado\nCtrl + N: Abrir formulario de Agregar\nCtrl + G: Confirmar o Guardar movimiento\nCtrl + I: Importar\nCtrl + R: Exportar\nCtrl + D: Descargar (plantilla)\nCtrl + P: Vista Previa" styleClass="texto-atajo" wrapText="true" />

                    <Label text="ACCIONES ESPECÍFICAS:" styleClass="seccion-atajo" />
                    <Label text="Ctrl + N + M: Agregar Nueva Marca en Clasificación\nCtrl + N + E: Agregar Nueva Etiqueta en Clasificación\nCtrl + N + B: Agregar Nueva Ubicación en Clasificación\nCtrl + N + U: Agregar Nueva Unidad de medida en Clasificación\nCtrl + Q: Abrir Formulario de Quitar Producto en Ajuste Inventario" styleClass="texto-atajo" wrapText="true" />
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</StackPane>
