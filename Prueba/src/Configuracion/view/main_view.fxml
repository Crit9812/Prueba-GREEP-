<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           xmlns="http://javafx.com/javafx"
           fx:controller="Configuracion.controller.MainController"
           fx:id="root"
           stylesheets="@/Configuracion/style/estilos.css">

    <VBox fx:id="contenedor" spacing="20" alignment="TOP_CENTER" styleClass="contenedor-config">
        <padding>
            <Insets top="30" right="30" bottom="30" left="30" />
        </padding>

        <!-- Título de la sección -->
        <Label text="Configuración del Sistema"
               styleClass="titulo-config"
               style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- Aquí puedes agregar el contenido específico de Configuración -->
        <VBox spacing="15" styleClass="panel-config" VBox.vgrow="ALWAYS">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20" />
            </padding>

            <!-- Ejemplo de opciones de configuración -->
            <Label text="Opciones generales" styleClass="subtitulo-config" />

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Opción 1:" minWidth="120" />
                <Button text="Configurar" />
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Opción 2:" minWidth="120" />
                <Button text="Ver reportes"  />
            </HBox>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Opción 3:" minWidth="120" />
                <Button text="Consultar"  />
            </HBox>

            <Region VBox.vgrow="ALWAYS" />
        </VBox>

    </VBox>
</StackPane>