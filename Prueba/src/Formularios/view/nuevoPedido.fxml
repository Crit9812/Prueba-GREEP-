<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            xmlns="http://javafx.com/javafx"
            prefWidth="500" prefHeight="400"
            style="-fx-background-color: white; -fx-padding: 20;"
            stylesheets="@/Formularios/style/estilos.css">

    <!-- Título -->
    <top>
        <Label text="Nuevo pedido"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <!-- Contenido principal -->
    <center>
        <VBox spacing="15" alignment="TOP_LEFT" style="-fx-padding: 20;">
            <HBox>
                <VBox spacing="5">
                    <Label text="Ingresar producto por:"/>
                    <HBox spacing="10">
                        <VBox spacing="5">
                            <Label text="Clave producto:"/>
                            <TextField fx:id="txtClaveProducto" prefWidth="150" maxWidth="150"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Clave alterna:"/>
                            <TextField fx:id="txtClaveProveedor" prefWidth="150" maxWidth="150"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Producto y Cantidad -->
            <HBox spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Producto:"/>
                    <TextField fx:id="txtProducto" prefWidth="300"
                               maxWidth="300"/>
                </VBox>

                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Cantidad:"/>
                    <TextField fx:id="txtCantidad" prefWidth="100"
                               maxWidth="100"/>
                </VBox>
            </HBox>

            <!-- Producto y Cantidad -->
            <HBox spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Descripción:"/>
                    <TextField fx:id="txtDescripcion" style=" -fx-min-height: 40;"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

    <!-- Botones -->
    <bottom>
        <HBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Button text="Guardar" fx:id="btnGuardar" styleClass="boton"/>
        </HBox>
    </bottom>
</BorderPane>
