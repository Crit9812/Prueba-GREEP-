<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Formularios.controller.controllerUbicacionTraspaso">
    <top>
        <VBox spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="20" right="20" bottom="10" left="20"/>
            </padding>
            <Label fx:id="lblTitulo" text="Ubicaciones" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="15" fx:id="contenedorPrincipal">
                    <padding>
                        <Insets top="10" right="20" bottom="20" left="20"/>
                    </padding>
                    <Label text="Captura las ubicaciones para este traspaso:" style="-fx-font-size: 13px;"/>
                    <VBox fx:id="contenedorUbicaciones" spacing="10"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>
            <Button fx:id="btnCancelar" text="Cancelar" onAction="#cerrarFormulario"/>
            <Button fx:id="btnConfirmar" text="Confirmar" onAction="#confirmarUbicaciones"/>
        </HBox>
    </bottom>
</BorderPane>
